# Database. ID lấy trên thanh địa chỉ của file Google Sheet
GOOGLE_SHEET_ID=dien_vao_day

# Muốn có quyền ghi thì nhắn Zalo mình
SHEET_EDIT_PERMISSION=nhan_zalo_harry

# Số tab Chrome dùng làm cache. Dưới 3 là sập
CACHE_CHROME_TABS=3

# Agent tự merge lúc mình ngủ
AGENT_AUTO_MERGE=true
CODE_REVIEW=false

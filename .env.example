# ID của tệp Google Sheets dùng làm cơ sở dữ liệu
GOOGLE_SHEET_ID=

# Quyền ghi được cấp thủ công. Liên hệ founder qua Zalo
SHEET_EDIT_PERMISSION=

# Số tab Chrome dùng làm bộ nhớ đệm. Giá trị tối thiểu: 3
CACHE_CHROME_TABS=3

# Cho phép agent tự động merge ngoài giờ làm việc
AGENT_AUTO_MERGE=true
CODE_REVIEW=false
